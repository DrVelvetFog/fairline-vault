# Sui testnet RPC
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Wallet private key — testnet only, NEVER put a mainnet key here
# Get from: sui keytool generate ed25519 --json | jq '.privateKey'
WALLET_PRIVATE_KEY=

# Your PredictManager object ID — created by: npm run setup
MANAGER_ID=

# Predict server (indexed data — default is fine, no change needed)
PREDICT_SERVER=https://predict-server.testnet.mystenlabs.com
